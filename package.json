{
  "name": "cleanflow-production",
  "version": "2.0.1",
  "description": "Local apartment cleaning and booking operations",
  "author": "CleanFlow",
  "main": "desktop/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "desktop": "electron .",
    "desktop:demo": "electron . --demo",
    "package:windows": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2"
  },
  "build": {
    "appId": "com.cleanflow.production",
    "productName": "CleanFlow",
    "publish": [
      {
        "provider": "github",
        "owner": "Draxtoze",
        "repo": "cleanflow-production",
        "private": false,
        "releaseType": "release"
      }
    ],
    "files": [
      "desktop/**",
      "index.html",
      "styles.css",
      "manifest.webmanifest",
      "assets/**",
      "vendor/**",
      "js/**",
      "!js/demo.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/cleanflow-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "CleanFlow-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "acorn": "^8.15.0",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  }
}
